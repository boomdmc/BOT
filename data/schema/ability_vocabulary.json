      "notSameAs": "{ref, fields: [...]}",
      "anyOf": "Filter[] (OR)",
      "nameHasNot": "string[] คำที่ต้องไม่อยู่ในชื่อ"
    },
    "Selector": {
      "ref": "ref | 'chosen:<as>' (ภายในความสามารถเดียว) | 'card:<remember>' (ข้ามความสามารถของการ์ดใบเดียวกัน)",
      "side": "side",
      "zone": "zone",
      "filter": "Filter",
      "count": "int | 'all' | {upTo:int} | {min:int, max:int}",
      "chooser": "chooser",
      "as": "string — name to refer back via ref 'chosen:<as>'",
      "totalCost": "{max: int|Amount}",
      "remember": "string — จำการ์ดที่เลือกไว้บน Card Instance ของการ์ดต้นทาง (ใช้ข้ามความสามารถของการ์ดใบเดียวกัน) อ้างด้วย ref \"card:<key>\"",
      "top": "int — เลือก N ใบบนสุด (ใช้กับ zone deck)",
      "lowest": "'cost'|'power'|'gem' — เลือกใบที่ค่าต่ำสุด (เสมอกัน = chooser เลือก)",
      "highest": "'cost'|'power'|'gem' — เลือกใบที่ค่าสูงสุด",
      "zones": "zone[] — เลือกจากหลาย Zone (เช่น [\"hand\",\"field\"])"
    },
    "Amount": "int | {count: Selector, times?: int (คูณ — 'ใบละ N'), per?: int (หาร ปัดลง — 'ทุก N ใบ' DIV-01), max?: int, plus?: int} | {stat: 'power'|'cost'|'gem', of: Selector} | {lifeFaceUp: player, times?: int} | {handCount: player} | {x: 'chosen number'} | {stat: 'printedPower'|'basePower', of} | {minus: [Amount, Amount]} | {sum: [Amount...]} (stat ของ Selector หลายใบ = ผลรวม)",
